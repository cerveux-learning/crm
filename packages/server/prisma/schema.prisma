generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(uuid())
  name      String
  email     String      @unique
  password  String
  role      String      @default("SELLER") // ADMIN, SELLER, VIEWER
  active    Boolean     @default(true)
  sales     SaleOrder[]
  deals     Deal[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Customer {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  phone      String?
  company    String?
  position   String?
  status     String     @default("LEAD") // LEAD, PROSPECT, CUSTOMER, INACTIVE
  address    String?
  tags       String?    // JSON stringified array of tags
  notes      String?
  deals      Deal[]
  sales      SaleOrder[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Deal {
  id                String     @id @default(uuid())
  title             String
  value             Float      @default(0)
  currency          String     @default("ARS")
  stage             String     @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, NEGOTIATION, WON, LOST
  priority          String     @default("MEDIUM") // LOW, MEDIUM, HIGH
  probability       Int        @default(20) // 0 - 100
  expectedCloseDate DateTime?
  notes             String?
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities        Activity[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Product {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  category    String          @default("PRODUCT") // PRODUCT, SERVICE, SUBSCRIPTION, OTHER
  unitPrice   Float           @default(0)
  cost        Float?
  stock       Int             @default(0)
  active      Boolean         @default(true)
  saleItems   SaleOrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SaleOrder {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  type           String          @default("QUOTE") // QUOTE, INVOICE
  status         String          @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, PAID, CANCELLED
  issueDate      DateTime        @default(now())
  dueDate        DateTime?
  subtotal       Float           @default(0)
  taxRate        Float           @default(0.21)
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  total          Float           @default(0)
  notes          String?
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          SaleOrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SaleOrderItem {
  id          String     @id @default(uuid())
  saleOrderId String
  saleOrder   SaleOrder  @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Float      @default(1)
  unitPrice   Float      @default(0)
  discount    Float      @default(0)
  total       Float      @default(0)
}

model Activity {
  id          String    @id @default(uuid())
  type        String    @default("NOTE") // CALL, MEETING, EMAIL, NOTE, TASK
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
